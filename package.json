{
  "name": "cote-a-cote",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "mobile": "pnpm --filter mobile start",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write \"apps/mobile/src/**/*.{ts,tsx}\" \"packages/*/src/**/*.ts\" \"supabase/functions/**/*.ts\"",
    "format:check": "prettier --check \"apps/mobile/src/**/*.{ts,tsx}\" \"packages/*/src/**/*.ts\" \"supabase/functions/**/*.ts\"",
    "test:functions": "cd supabase/functions && deno test --allow-env",
    "check:functions": "cd supabase/functions && deno check **/*.ts"
  },
  "devDependencies": {
    "deno": "2.9.6",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0"
  }
}
