# Projet Supabase (Paramètres du projet > API). Pour le développement local : `supabase start`.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Abonnements (RevenueCat : Project settings > API keys, clés publiques par plateforme).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Sans clé RevenueCat : achats simulés (pile locale uniquement, fonction simulate-purchase activée).
EXPO_PUBLIC_PAYMENTS_SIMULATION=false
# Liens affichés sur l'écran d'abonnement (exigés par Apple et Google).
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
